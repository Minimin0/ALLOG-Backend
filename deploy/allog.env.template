# ALLOG Backend — 서버 환경변수
# 서버에 /etc/allog/allog.env 로 두고 권한 600, 소유자는 앱 실행 계정.
# 이 파일 자체를 git에 올리지 말 것.

# ── 필수: 데이터베이스 ─────────────────────────────────────────
# 기동 시 Flyway가 V1→V17을 자동 적용하고, ddl-auto=validate가
# 스키마를 검사한다. 불일치하면 기동이 실패한다(의도된 안전장치).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=allog
DB_USERNAME=allog_app
DB_PASSWORD=

# ── 필수: Firebase 인증 ───────────────────────────────────────
# 프론트 EXPO_PUBLIC_FIREBASE_PROJECT_ID 와 반드시 같은 프로젝트여야 한다.
# 다르면 로그인은 되는데 백엔드가 401을 준다.
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=
# 서비스 계정 JSON의 절대경로. 저장소 밖, 권한 600.
GOOGLE_APPLICATION_CREDENTIALS=/etc/allog/firebase-service-account.json

# ── 그룹 라이프사이클 스케줄러 ──────────────────────────────────
# 기본 ON. 60초마다 그룹 상태를 정리한다.
# 주의: 인스턴스를 2대 이상으로 늘리면 중복 실행된다. 지금은 1대로 운영.
GROUP_LIFECYCLE_ENABLED=true
GROUP_LIFECYCLE_RECONCILE_DELAY=60s
GROUP_LIFECYCLE_BATCH_SIZE=100

# ── 선택: AI Coach (OpenAI) ───────────────────────────────────
# 키가 없으면 TEMPLATE 폴백으로 동작한다. 비워도 기동에 문제없다.
OPENAI_API_KEY=
AI_COACH_MODEL=
AI_COACH_TIMEOUT=3s

# ── 선택: 사진 인증 저장소 (S3) ────────────────────────────────
# ★ 함정: enabled=true 로 켤 거면 아래 6개를 "전부" 채워야 한다.
#   max-bytes 기본 0, upload-expiry 기본 0s, content-types 기본 빈값이라
#   앞 3개만 채우면 validate에서 기동이 실패한다.
# 끄고 갈 거면 false 그대로 두면 된다. upload-intent가 503일 뿐
# 나머지 기능은 정상 동작한다.
VERIFICATION_MEDIA_ENABLED=false
AWS_REGION=
VERIFICATION_MEDIA_BUCKET=
VERIFICATION_MEDIA_MAX_BYTES=10485760
VERIFICATION_MEDIA_UPLOAD_EXPIRY=300s
VERIFICATION_MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png

# ── 선택: AI 사진 인증 (Anthropic) ─────────────────────────────
# S3가 켜져 있어야 의미가 있다. 분석할 이미지가 있어야 하므로.
VERIFICATION_ANALYSIS_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
VERIFICATION_ANALYSIS_ANTHROPIC_MODEL=
VERIFICATION_ANALYSIS_ANTHROPIC_REQUEST_TIMEOUT=30s

# ── 선택: 분석 수동 실행 권한 ──────────────────────────────────
# 비어 있으면 아무도 process-next 를 못 쓴다(예산 보호). 쉼표 구분 userId.
ALLOG_VERIFICATION_ANALYSIS_OPERATIONS_OPERATOR_USER_IDS=

# ── 서버 ───────────────────────────────────────────────────────
# nginx가 앞에서 TLS를 끊고 여기로 넘긴다. 외부에 8080을 열지 않는다.
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
