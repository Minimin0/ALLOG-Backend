# ALLOG Backend — 환경변수 예시
#
# 로컬 개발용이다. 서버 배포용 전체 설정과 함정 설명은 deploy/allog.env.template 를 볼 것.
# 실제 값이 들어간 .env 는 절대 커밋하지 않는다 (.gitignore 가 막고 있다).

# ── 서버 ──────────────────────────────────────────────────────
SERVER_PORT=8080
# 리버스 프록시 뒤에 둘 때는 127.0.0.1 로 묶어 외부 노출을 막는다.
SERVER_ADDRESS=0.0.0.0

# ── 데이터베이스 ───────────────────────────────────────────────
# 기동 시 Flyway 가 V1→V17 을 적용하고 ddl-auto=validate 가 스키마를 검사한다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=allog
DB_USERNAME=allog
DB_PASSWORD=change-me

# ── Firebase 인증 ─────────────────────────────────────────────
# enabled=true 인데 서비스 계정 JSON 이 없거나 PROJECT_ID 가 비면 기동이 실패한다.
# GOOGLE_APPLICATION_CREDENTIALS 는 JSON 절대경로를 가리키는 표준 환경변수다.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ── AI Coach (OpenAI) ─────────────────────────────────────────
# 키가 없으면 TEMPLATE 폴백으로 동작한다. 비워도 기동에 지장 없다.
OPENAI_API_KEY=
AI_COACH_MODEL=
AI_COACH_TIMEOUT=3s

# ── 그룹 라이프사이클 스케줄러 ──────────────────────────────────
# 인스턴스를 2대 이상 띄우면 중복 실행된다.
GROUP_LIFECYCLE_ENABLED=true
GROUP_LIFECYCLE_RECONCILE_DELAY=60s
GROUP_LIFECYCLE_BATCH_SIZE=100

# Verification media storage: Android -> nginx -> Spring -> private local filesystem (no S3/AWS bucket).
# Set all seven keys when enabled; signing secret must be 32+ bytes and must never be committed.
VERIFICATION_MEDIA_ENABLED=false
VERIFICATION_MEDIA_LOCAL_ROOT=/var/lib/allog/verification-media
VERIFICATION_MEDIA_LOCAL_BASE_URL=https://api.example.com
VERIFICATION_MEDIA_LOCAL_SIGNING_SECRET=
VERIFICATION_MEDIA_MAX_BYTES=10485760
VERIFICATION_MEDIA_UPLOAD_EXPIRY=300s
VERIFICATION_MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png
# Anthropic analysis only runs after a verification media submission.
VERIFICATION_ANALYSIS_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
VERIFICATION_ANALYSIS_ANTHROPIC_MODEL=
VERIFICATION_ANALYSIS_ANTHROPIC_REQUEST_TIMEOUT=30s

# ── 분석 수동 실행 권한 ────────────────────────────────────────
# 비어 있으면 아무도 process-next 를 호출할 수 없다(프로바이더 예산 보호).
# 쉼표로 구분한 userId 목록.
ALLOG_VERIFICATION_ANALYSIS_OPERATIONS_OPERATOR_USER_IDS=
